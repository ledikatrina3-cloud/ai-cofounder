# ─────────────────────────────────────────────────────────────────────────────
# NOT ACTIVE. Это ПРИМЕР. По умолчанию агент пишет статью в ./content/ и НИЧЕГО
# не публикует во внешний мир.
#
# Чтобы включить внешнюю публикацию: скопируй этот файл в `target.yml` (без
# суффикса .example), заполни значения под свой проект и поставь в AGENT.md
# enabled: true. Пока файла `target.yml` нет - внешняя публикация выключена.
# ─────────────────────────────────────────────────────────────────────────────

# Рабочая директория target-репозитория (downstream-проект, где живёт
# платформенный адаптер-публикатор). Агент запустит адаптер в этом cwd.
# Пример: каталог твоего сайта/блога.
cwd: "~/projects/your-site-repo"

# Allowlist скиллов, которые агенту разрешено вызывать в target-репозитории.
# Только то, что реально нужно для публикации.
skills:
  - article-writing
  - cover-design

# Переменные окружения, которые надо прокинуть в target/.env.local перед
# запуском адаптера (иначе скилл в чужом cwd их не увидит). Значения НЕ хранятся
# здесь - здесь только ИМЕНА. Реальные токены лежат в твоём хранилище секретов.
# Замени PUBLISH_TOKEN на имя переменной твоей платформы публикации.
syncEnv:
  - PUBLISH_TOKEN
  # - INTERNAL_LINK_DOMAIN   # домен для абсолютизации внутренних ссылок (по умолчанию acme.example.com)

# Адаптер-публикатор НЕ настраивается здесь. Парсер target.yml читает только
# cwd / host / skills / maxTurns / syncEnv. Какой адаптер запускать - решает сам
# target-репозиторий (платформа инкапсулирована на его стороне, ядро агента её
# не знает). Здесь поля adapter нет специально.
