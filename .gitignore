# Pipeline outputs (артефакты pipeline executor — Фаза 5).
# Файлы создаются автоматически нодами executor'а: research/<date>.md,
# outlines/<date>.md, seo-audits/<date>.json и т.п. В git их не храним —
# это runtime-данные. Шаблон директории `.gitkeep` оставляем.
outputs/
!outputs/.gitkeep

# Playwright MCP session artifacts (console logs + page snapshots)
.playwright-mcp/

# Generated screenshots/screenshots from playwright в корне репо
/layout*.png
/marketplace*.png
/nav-*.png
/seo-*.png

# Local server secrets
.secrets/
