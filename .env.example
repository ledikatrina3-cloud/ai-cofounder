# ─────────────────────────────────────────────────────────────────────────────
# .env.example — local configuration template for AI-Cofounder.
#
# Copy to .env (or .env.local) and adjust. All .env* files are git-ignored.
# Loading: src/env.ts reads .env.local first, then .env (see loadEnv).
#
# IMPORTANT about secrets: the primary secret store is the macOS Keychain (via
# keytar). Bot tokens, refresh tokens and other sensitive values belong there,
# NOT in this file. .env is only for local dev configuration: paths, ports,
# flags and transport switches. Never commit real secret values — keep the
# sensitive fields empty.
# ─────────────────────────────────────────────────────────────────────────────


# ── Core ─────────────────────────────────────────────────────────────────────
# Path to the SQLite file for Prisma. Resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Absolute path to the folder holding your downstream projects (cross-project
# routines spawn `claude` in their cwd). For example: $HOME/projects
# The registry of the projects themselves is config/projects.md.
PROJECTS_ROOT=


# ── LLM transport ────────────────────────────────────────────────────────────
# `apikey` (DEFAULT, recommended) — direct Anthropic API via ANTHROPIC_API_KEY.
#   No extra infrastructure. Put the key in .env.local (not here). See ADR 0007.
# `oauth` (EXPERIMENTAL, NOT endorsed, at your own risk) — route via a local
#   gateway at LLM_GATEWAY_URL that you run YOURSELF (not shipped in OSS). May
#   conflict with the LLM provider's ToS; use under your own responsibility.
LLM_TRANSPORT=apikey

# Anthropic API key — put it in .env.local (git-ignored), NOT in .env.
# (The apikey transport reads it from the environment.)

# Base URL of the local gateway. Only for the experimental LLM_TRANSPORT=oauth.
LLM_GATEWAY_URL=http://127.0.0.1:8787

# Path to the `claude` CLI binary. Optional — by default it is looked up in PATH.
# Only for the experimental oauth mode (src/llm/subagent-cli.ts).
CLAUDE_CLI_PATH=


# ── Optional LLM proxy ───────────────────────────────────────────────────────
# External proxy for LLM calls (e.g. cover generation). Both values empty —
# the proxy is disabled. URL looks like https://your-llm-proxy.example.com
LLM_PROXY_URL=
# Shared secret for authorizing against the proxy. Never commit a real value.
LLM_PROXY_SECRET=


# ── Optional Gemini (cover generation) ───────────────────────────────────────
# Google Gemini API key for article cover generation. Empty — feature disabled.
GEMINI_API_KEY=


# ── Bridge UI (Hono server + React office) ───────────────────────────────────
# Bridge server port (default 3737). Applies to both sides (root + bridge/).
BRIDGE_PORT=3737
# Explicit bridge base URL. Empty — assembled as http://127.0.0.1:${BRIDGE_PORT}.
BRIDGE_URL=
# `true` — Electron wrapper development mode. Otherwise leave empty.
BRIDGE_DEV=
# `off` — disable DevTools in Electron. Any other value — enabled.
BRIDGE_DEVTOOLS=
# Directory for bridge sessions. Empty — uses the default path.
BRIDGE_SESSIONS_DIR=


# ── vc.ru publishing (optional integration) ──────────────────────────────────
# vc.ru refresh token. Prefer the Keychain; here only for local dev, and NEVER
# with a real value in git.
VC_REFRESH_TOKEN=
# Local vc-bridge port (default 7777).
VC_BRIDGE_PORT=7777
# vc-bridge base URL (default http://localhost:7777).
VC_BRIDGE_URL=http://localhost:7777
# Your personal vc.ru blog id (used as user_id in the Osnova API).
VC_USER_ID=
# vc.ru subsite/community id where posts are updated (scripts/regen-cover-*).
VC_SUBSITE_ID=
# Your vc.ru profile handle for the auth check (scripts/verify-vc.ts):
# https://vc.ru/<handle>. Empty — a placeholder stub is used.
VC_PROFILE_HANDLE=
# Domain of YOUR downstream project, used to rewrite relative internal links
# (/guides, /topics, ...) inside vc.ru articles into absolute https://<domain>/...
# Empty — defaults to the example domain acme.example.com (links point at the stub).
INTERNAL_LINK_DOMAIN=


# ── Misc ─────────────────────────────────────────────────────────────────────
# Chrome channel for patchright/browser sessions (e.g. chrome, chrome-beta).
# Empty — the default channel.
CHROME_CHANNEL=
# Locale and timezone of the browser profile. Neutral default: en-US / UTC.
# For a specific platform set e.g. BROWSER_LOCALE=en-US and
# BROWSER_TIMEZONE=America/New_York (or your own region).
BROWSER_LOCALE=
BROWSER_TIMEZONE=
# Consent for dangerous Prisma operations (e.g. `migrate reset`) under Claude Code.
# Set to `1` only when you deliberately run a reset.
PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=


# ── Secrets that do NOT go here ───────────────────────────────────────────────
# Telegram bot tokens (main and support bot) live in the macOS Keychain, not in
# .env — the Biome rule noProcessEnv deliberately forbids reading them from
# process.env. See src/telegram/** and infrastructure/.
